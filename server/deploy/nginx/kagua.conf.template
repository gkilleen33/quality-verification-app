# nginx vhost for the Kagua API. Installed to /etc/nginx/sites-available/kagua
# with __SERVER_NAME__ substituted, then symlinked into sites-enabled.
#
# Certbot's --nginx plugin needs a server block whose server_name matches the -d
# argument, so this goes on before the certificate exists, not after. Certbot then
# adds the listen 443 block, the certificate paths and the http->https redirect
# itself; everything below is what it will not touch.
#
# ISSUED 1 Sep 2026 for kagua.gradykilleen.me, expiry 30 Nov 2026, auto-renewing.
#
# DO NOT re-install this template over a host that already has a certificate. Certbot
# edits /etc/nginx/sites-available/kagua in place, so this file is only the pre-TLS
# form: copying it back over would drop the listen 443 block and return the site to
# plain HTTP, which the app refuses to talk to. To change anything here after issuance,
# edit the file on the host, or re-install this and then re-run:
#   certbot --nginx -d kagua.gradykilleen.me --redirect
#
# Verified after issuance: client_max_body_size and proxy_read_timeout both landed in
# the 443 block, not in the redirect-only port 80 block. Worth re-checking if certbot
# ever restructures the file, because a 25m limit on a block that only issues 301s is
# indistinguishable from no limit at all until a photo upload returns 413.

# Rate limit for the admin login form, in the http context via a snippet included from
# nginx.conf — a limit_req_zone cannot live inside a server block. See
# server/deploy/nginx/kagua-admin-ratelimit.conf.
#
# The alternative first considered was an outer HTTP Basic gate. Rejected: with a password
# and a TOTP code already in play, a third shared credential buys little and invites reuse,
# whereas rate limiting keeps scanners out of application code at no cost to the admins.

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    # ACME HTTP-01 challenge. Kept explicit so a later catch-all redirect cannot
    # shadow it and quietly break renewals — the failure would surface 90 days
    # later as an expired certificate.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    # The two settings that differ from nginx's defaults and fail silently.
    #
    # client_max_body_size: default 1m. One assessment turn carries up to nine
    # base64-encoded photos. Exceeding it returns 413 before the request reaches
    # the app, so nothing appears in the application log at all.
    client_max_body_size 25m;

    # proxy_read_timeout: default 60s. Claude vision requests on a slow connection
    # routinely take longer, and the app's own client waits 120s. A 60s cutoff here
    # 504s exactly the slowest and most valuable requests, and reads as an app bug.
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_connect_timeout 15s;

    # The admin login and 2FA forms, rate limited. Everything else under /admin is behind
    # a session cookie, so the two unauthenticated forms are the only brute-forceable
    # surface — and the account lockout behind them is per account, which does nothing
    # about somebody spraying one password across many addresses.
    location ~ ^/admin/(login|2fa)$ {
        limit_req zone=kagua_admin_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # No buffering of request bodies to disk: they are photographs, and the point
        # of this service is not to accumulate copies of them in /var. It also means a
        # slow uploader on a Kampala mobile connection does not hold a temp file open
        # for the duration.
        proxy_request_buffering off;

        # Note the absence of proxy_buffering off, and do not add it here.
        #
        # Response buffering is on by default and would hold a streamed reply until it
        # was complete — the exact blank wait that streaming exists to remove. It is
        # switched off per response instead: /v1/chat/stream sends X-Accel-Buffering: no,
        # which nginx honours for that response alone. That keeps the setting in the jar,
        # where it is deployed atomically and cannot be left behind by an operator who
        # updated the jar but not this file. Turning it off for the whole location would
        # also un-buffer photo downloads and every admin page, which want buffering.
    }
}
