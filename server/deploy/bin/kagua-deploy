#!/bin/bash
# Installs a release asset built by CI and restarts the service.
#
# Pulls from GitHub rather than being pushed to: the box has no inbound SSH, and this
# way a deploy is one SSM command that needs no credentials of its own. Public repo,
# so no token is involved.
set -euo pipefail

TAG="${1:-nightly}"
REPO=gkilleen33/quality-verification-app
URL="https://github.com/$REPO/releases/download/$TAG/kagua-server.jar"

echo "fetching $URL"
# To a temporary file first: a half-downloaded jar written straight over the live one
# would leave the service unable to start after a restart.
tmp=$(mktemp /tmp/kagua-XXXXXX.jar)
curl -fsSL --retry 3 -o "$tmp" "$URL"

# Sanity check before it goes anywhere near the running service.
if ! unzip -l "$tmp" >/dev/null 2>&1; then
  echo "downloaded file is not a valid jar, refusing to install" >&2
  rm -f "$tmp"; exit 1
fi

install -o kagua -g kagua -m 0640 "$tmp" /opt/kagua/kagua.jar
rm -f "$tmp"
echo "$TAG" > /opt/kagua/VERSION
chown kagua:kagua /opt/kagua/VERSION

systemctl restart kagua

# Poll for readiness rather than sleeping. Startup is around six seconds — three
# Parameter Store calls, then the connection pool, then Ktor — and a fixed sleep
# either reports a false failure on a healthy service or pads every deploy with a
# margin nobody measured. Deadline, not a guess.
deadline=$((SECONDS + 60))
until curl -fsS --max-time 5 http://127.0.0.1:8080/healthz >/dev/null 2>&1; do
  if ! systemctl is-active --quiet kagua; then
    echo "service died during startup:" >&2
    journalctl -u kagua -n 30 --no-pager >&2
    exit 1
  fi
  if [ "$SECONDS" -ge "$deadline" ]; then
    echo "still not answering /healthz after 60s:" >&2
    journalctl -u kagua -n 30 --no-pager >&2
    exit 1
  fi
  sleep 1
done

echo "healthz:  $(curl -fsS --max-time 5 http://127.0.0.1:8080/healthz)"
# Reported, not enforced: a database that is briefly unreachable should not make a
# deploy look failed when the jar installed correctly.
echo "deep:     $(curl -sS --max-time 15 http://127.0.0.1:8080/healthz/deep)"
