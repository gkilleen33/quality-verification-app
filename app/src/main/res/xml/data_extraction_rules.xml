<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore-wrapped keys are device-bound: a restored copy of the encrypted
         prefs would be undecryptable, so exclude everything from transfer. -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
