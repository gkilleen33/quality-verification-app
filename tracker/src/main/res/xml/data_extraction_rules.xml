<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore-wrapped keys are device-bound, and the payment log is one person's: nothing
         leaves the phone in a backup or a transfer. -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
